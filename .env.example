# ============ Security ============
AGENT_API_KEY=dev-secret-key

# ============ LLM provider: deepseek | openai | ollama | rule ============
LLM_PROVIDER=rule

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ============ Storage & retrieval ============
DB_PATH=agent.db
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============ Server ============
CORS_ORIGINS=*
LOG_LEVEL=INFO